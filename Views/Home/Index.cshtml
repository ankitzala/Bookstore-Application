@{
    ViewData["Title"] = "Home Page";
}

<!-- HERO SECTION -->
<section class="py-5 text-center text-white">
    <div class="shadow-sm p-3 mb-5 bg-body rounded">
        <h2 class="mb-4">Welcome To Book Store</h2>
        <button type="button" class="btn btn-primary">Explore Books</button>
    </div>
</section>

<!-- TOP BOOKS TITLE -->
<div class="container mt-5">
    <h3 class="text-center mb-4">Top Books</h3>
</div>

<!-- BOOK CARDS -->
<div class="container mb-5">
    <div class="row justify-content-center g-4">

        <!-- Book 1 -->
        <div class="col-lg-4 col-md-6 col-12">
            <div class="card h-100 mx-auto" style="width: 18rem;">
                <div class="ratio ratio-16x9 bg-secondary d-flex align-items-center justify-content-center text-white">
                    No Image
                </div>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Clean Code</h5>
                    <p class="card-text">
                        A practical guide to writing clean, readable,
                        and maintainable code.
                    </p>

                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item"><strong>Author:</strong> Robert C. Martin</li>
                        <li class="list-group-item"><strong>Category:</strong> Programming</li>
                        <li class="list-group-item"><strong>Pages:</strong> 464</li>
                        <li class="list-group-item"><strong>Language:</strong> English</li>
                    </ul>

                    <div class="mt-auto text-center">
                        <a href="#" class="btn btn-primary">View Details</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Book 2 -->
        <div class="col-lg-4 col-md-6 col-12">
            <div class="card h-100 mx-auto" style="width: 18rem;">
                <div class="ratio ratio-16x9 bg-info d-flex align-items-center justify-content-center text-white">
                    No Image
                </div>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Atomic Habits</h5>
                    <p class="card-text">
                        Learn how small habits can lead to remarkable success.
                    </p>

                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item"><strong>Author:</strong> James Clear</li>
                        <li class="list-group-item"><strong>Category:</strong> Self-Help</li>
                        <li class="list-group-item"><strong>Pages:</strong> 320</li>
                        <li class="list-group-item"><strong>Language:</strong> English</li>
                    </ul>

                    <div class="mt-auto text-center">
                        <a href="#" class="btn btn-primary">View Details</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Book 3 -->
        <div class="col-lg-4 col-md-6 col-12">
            <div class="card h-100 mx-auto" style="width: 18rem;">
                <div class="ratio ratio-16x9 bg-dark d-flex align-items-center justify-content-center text-white">
                    No Image
                </div>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">The Alchemist</h5>
                    <p class="card-text">
                        A timeless story about dreams and destiny.
                    </p>

                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item"><strong>Author:</strong> Paulo Coelho</li>
                        <li class="list-group-item"><strong>Category:</strong> Fiction</li>
                        <li class="list-group-item"><strong>Pages:</strong> 208</li>
                        <li class="list-group-item"><strong>Language:</strong> English</li>
                    </ul>

                    <div class="mt-auto text-center">
                        <a href="#" class="btn btn-primary">View Details</a>
                    </div>
                </div>
            </div>
        </div>

    </div> 
</div> 
